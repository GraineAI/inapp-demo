  "actions": [
    {
      "name": "open_screen",
      "effect": "open_screen",
      "label": "Open",
      "description": "Take the shopper to a screen in the app: home, chat, orders, calls (their booked delivery calls), memory (what you remember about them) or profile. Use it instead of describing where to tap.",
      "args": [
        {
          "name": "screen",
          "type": "string",
          "required": true,
          "description": "The screen to open.",
          "enum": ["home", "chat", "orders", "calls", "memory", "profile"]
        }
      ]
    },
    {
      "name": "open_item",
      "effect": "open_item",
      "label": "Track",
      "description": "Open one of the shopper's orders so they can see its delivery details. Name the order by its product or its order number.",
      "args": [
        { "name": "item", "type": "string", "required": true, "description": "The product or the order number, e.g. \"Running shoes, size 7\" or \"GD-55120\"." }
      ]
    },
    {
      "name": "request_return",
      "effect": "set_status",
      "label": "Return",
      "status": "Return requested",
      "description": "Start a return for a delivered order, when the shopper asks to return it and it is still within its return date. Confirm which order first.",
      "args": [
        { "name": "item", "type": "string", "required": true, "description": "The product or the order number, e.g. \"Yoga mat, 6 mm\" or \"GD-54702\"." }
      ]
    },
    {
      "name": "cancel_order",
      "effect": "set_status",
      "label": "Cancel order",
      "status": "Cancelled",
      "description": "Cancel an order that has not been delivered yet, when the shopper asks to cancel it. Confirm which order first.",
      "args": [
        { "name": "item", "type": "string", "required": true, "description": "The product or the order number, e.g. \"Wireless earbuds\" or \"GD-55302\"." }
      ]
    }
  ],
  "call": {
    "callName": "Tara · Graine Store",
