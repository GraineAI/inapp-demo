    {
      "tell": "I wear size 7 in running shoes.",
      "ask": "What size do I wear in running shoes?",
      "expect": "Size 7."
    },
    {
      "tell": "Please leave my parcels with the building security desk.",
      "ask": "Where should my parcels be left?",
      "expect": "With the building security desk."
    }
