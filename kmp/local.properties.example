# Copy to local.properties (git-ignored). Android Studio adds sdk.dir itself.
sdk.dir=/path/to/Android/sdk

# The agent's publishable key (Agent -> Embed & Widgets). Add app:// to the agent's Allowed domains.
graine.publishableKey=pk_live_replace_me
# Optional: a second agent (the pack's help desk) for the Help tab, with its own publishable key.
graine.helpPublishableKey=
# Optional: another server (default https://www.graine.ai).
graine.baseUrl=https://www.graine.ai
# Your Android application id. It must match the Android app registered under Workspace settings ->
# In-app calling, and the package in composeApp/google-services.json, for Graine to ring this app.
graine.applicationId=com.yourcompany.grainedemo.kmp

# Until Maven Central has ai.graine:inapp-kmp 0.8.0: build against the SDK's sources — checkouts of
# https://github.com/GraineAI/inapp-kmp and https://github.com/GraineAI/inapp-android (tag 0.8.0) in
# ../graine-sdk/kmp and ../graine-sdk/android beside this repository (see README.md); until Swift Package
# Manager has the 0.8.0 tag, inapp-ios in ../graine-sdk/ios too, for iosApp/use-local-sdk.sh.
# graine.kmpSdkDir=../../graine-sdk/kmp
