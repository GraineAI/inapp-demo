<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (src/androidDebug replaces the release file of the same name): plain http to this computer, for a
     Graine server running on it — graine.baseUrl=http://10.0.2.2:<port> in local.properties, from the emulator.
     Everything else stays https only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
