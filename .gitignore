# Per-developer configuration. Every app commits an *.example beside it.
.env
.env.*
!.env.example
Config.xcconfig
local.properties
google-services.json
GoogleService-Info.plist
*.p8

# Dependencies and build output
node_modules/
.expo/
dist/
build/
.gradle/
.kotlin/
.cxx/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
Pods/
DerivedData/
xcuserdata/
*.xcuserstate
*.tgz
.DS_Store

# React Native: the native projects are generated by `expo prebuild` from app.config.ts and plugins/
react-native/ios/
react-native/android/

# The local-SDK switch (scripts/use-local-sdks.sh) — never committed
react-native/.local-sdk/
flutter/pubspec_overrides.yaml

# Lock files: generated against SDK sources on this machine until the SDK versions are published; commit
# them once `npm install` / `flutter pub get` resolve the published versions.
react-native/package-lock.json
flutter/pubspec.lock
