# Copy to .env (git-ignored). Dashboard: your agent → Embed & Widgets → publishable key.
# One key for every pack…
EXPO_PUBLIC_GRAINE_PUBLISHABLE_KEY=pk_live_replace_me
# …or one agent per use-case pack (each pack is its own agent; see agent-setup/).
EXPO_PUBLIC_GRAINE_KEY_HEALTH_COACH=
EXPO_PUBLIC_GRAINE_KEY_BANKING_SUPPORT=
EXPO_PUBLIC_GRAINE_KEY_RETAIL_SHOPPING=
# The help agent of each pack — the Help screen (agent-setup/<pack>/help-settings.md). Optional: without one the
# Help screen says how to add it. One key for every pack, or one per pack.
EXPO_PUBLIC_GRAINE_HELP_KEY=
EXPO_PUBLIC_GRAINE_HELP_KEY_HEALTH_COACH=
EXPO_PUBLIC_GRAINE_HELP_KEY_BANKING_SUPPORT=
EXPO_PUBLIC_GRAINE_HELP_KEY_RETAIL_SHOPPING=
EXPO_PUBLIC_GRAINE_BASE_URL=https://www.graine.ai

# Build time only (app.config.ts). Use identifiers you own: push credentials are registered per app.
GRAINE_DEMO_IOS_BUNDLE_ID=ai.graine.demo.rn
GRAINE_DEMO_ANDROID_PACKAGE=ai.graine.demo.rn
# Firebase configuration for Android hosted ringing (from your Firebase project). Optional.
GRAINE_DEMO_GOOGLE_SERVICES_FILE=./google-services.json
